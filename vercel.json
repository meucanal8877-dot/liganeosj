{
  "cleanUrls": true,
  "crons": [{ "path": "/api/instagram-renovar", "schedule": "0 12 * * 1" }],
  "headers": [
    { "source": "/dados.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(img|video)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
